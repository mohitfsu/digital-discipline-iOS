<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Digital Discipline</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- Native Full-Screen Launch Storyboard Configuration -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
		<key>UIImageName</key>
		<string></string>
	</dict>
	
	<key>UIRequiresFullScreen</key>
	<true/>
	
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
	<!-- Privacy Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>Digital Discipline requires front camera access for real-time Vision AI body pose detection during physical friction workouts.</string>
	
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Digital Discipline uses your location to configure workplace, campus, and library geofences.</string>
	
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Digital Discipline requires background location access to automatically enforce focus policies upon entering designated zones.</string>
	
	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	
	<!-- Installed Apps Detection Schemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram</string>
		<string>youtube</string>
		<string>tiktok</string>
		<string>twitter</string>
		<string>x</string>
		<string>snapchat</string>
		<string>whatsapp</string>
		<string>reddit</string>
		<string>netflix</string>
		<string>spotify</string>
		<string>discord</string>
		<string>threads</string>
		<string>pinterest</string>
		<string>facebook</string>
		<string>tg</string>
		<string>twitch</string>
	</array>
	
	<!-- Deep Link URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.digitaldiscipline.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>digitaldiscipline</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
